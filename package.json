{
  "name": "super-el-nino-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Super El Nino Global Impact Simulator - an interactive R3F globe with a client-side DuckDB-WASM analytics engine.",
  "scripts": {
    "predev": "node scripts/copy-duckdb.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-duckdb.mjs",
    "build": "tsc -b && vite build && node scripts/check-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "data": "uv run python scripts/generate_enso_data.py",
    "gen:golden": "node scripts/gen-engine-golden.mjs",
    "e2e:golden": "node scripts/e2e/verify-live-golden.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit false --pretty false"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.10.0",
    "hyparquet": "^1.31.5",
    "playwright": "1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.9",
    "vitest": "^2.1.2"
  }
}
